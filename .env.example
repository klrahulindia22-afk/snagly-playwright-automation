# Front-end address. Use your current local URL when running tests locally.
BASE_URL=http://localhost:5275
# Backend address. Keep separate because the React app and FastAPI app use different ports locally.
API_BASE_URL=http://localhost:8000

# Test account only. Do not use personal or production credentials.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# true shows browser while a test runs; false is suited to CI.
HEADLESS=true

# Never store these in source control. Required only for API tests that create or manage users.
ADMIN_EMAIL=
ADMIN_PASSWORD=
